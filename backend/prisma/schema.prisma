generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  successCount Int       @default(0)
  failCount    Int       @default(0)
  ltv          Float     @default(0)
  createdAt    DateTime  @default(now())
  payments     Payment[]
}

model Payment {
  id                String            @id @default(cuid())
  amount            Int
  currency          String            @default("INR")
  customerId        String
  status            PaymentStatus     @default(FAILED)
  failureReason     String
  method            String
  retryCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  recoveredAt       DateTime?
  lastNotifiedAt    DateTime?
  lastRetryAt       DateTime?
  notificationCount Int               @default(0)
  experimentArm     String?
  experimentBatchId String?
  agentDecisions    AgentDecision[]
  agentState        AgentState?
  auditLogs         AuditLog[]
  customer          Customer          @relation(fields: [customerId], references: [id])
  recoveryAttempts  RecoveryAttempt[]
}

model AgentDecision {
  id                     String            @id @default(cuid())
  paymentId              String
  failureType            String
  recoverabilityScore    Float
  strategy               String
  retryAfterMinutes      Int?
  confidence             Float
  reasoning              String
  createdAt              DateTime          @default(now())
  alternativesConsidered Json?
  payment                Payment           @relation(fields: [paymentId], references: [id])
  policyChecks           PolicyCheck[]
  recoveryAttempts       RecoveryAttempt[]
}

model PolicyCheck {
  id         String        @id @default(cuid())
  decisionId String
  ruleName   String
  passed     Boolean
  reason     String
  createdAt  DateTime      @default(now())
  decision   AgentDecision @relation(fields: [decisionId], references: [id])
}

model RecoveryAttempt {
  id          String        @id @default(cuid())
  paymentId   String
  decisionId  String
  scheduledAt DateTime?
  executedAt  DateTime?
  outcome     String?
  createdAt   DateTime      @default(now())
  decision    AgentDecision @relation(fields: [decisionId], references: [id])
  payment     Payment       @relation(fields: [paymentId], references: [id])
}

model AgentState {
  id           String         @id @default(cuid())
  paymentId    String         @unique
  currentState AgentStateEnum @default(RECOVERY_STARTED)
  updatedAt    DateTime       @updatedAt
  payment      Payment        @relation(fields: [paymentId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  paymentId String
  event     String
  details   String?
  timestamp DateTime @default(now())
  payment   Payment  @relation(fields: [paymentId], references: [id])
}

enum PaymentStatus {
  FAILED
  RECOVERING
  RECOVERED
  ESCALATED
  STOPPED
}

enum AgentStateEnum {
  RECOVERY_STARTED
  ANALYZING
  DECISION_MADE
  POLICY_CHECKED
  ACTION_SCHEDULED
  ACTION_EXECUTED
  RESULT_RECEIVED
  COMPLETED
  ESCALATED
  STOPPED
}
